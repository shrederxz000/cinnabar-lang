// Пример 1: Факториал
n := 5;
factorial := 1;
i := 1;

while (i <= n) {
    factorial = factorial * i;
    i = i + 1;
}

print(factorial);

// Пример 2: Проверка четности
num := 42;
remainder := num - (num / 2) * 2;

if (remainder == 0) {
    print(num);
} else {
    print(0);
}

// Пример 3: Работа с типами
x:int = 100;
y:float = 3.14;
z := x + 10;

name:str = "Cinnabar";
version:str = "1.0";
info := name + " " + version;

print(info);
